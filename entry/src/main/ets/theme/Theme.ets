// Generated by the app factory: the app's design tokens. Every screen takes its colours, spacing,
// type sizes and radii from here, so the app looks like one app and follows light and dark mode.
// Colours are resources (the system's, plus the accent in resources/base|dark/element/color.json):
// never write a hex colour or Color.X in a screen. Need another colour (a category, a chart series)?
// Add it to color.json in BOTH base and dark and use $r('app.color.<name>').
export class AppColors {
  /** The accent: the one primary action of a screen, selected states, links. */
  static readonly brand: Resource = $r('app.color.brand');
  /** Text and icons on the accent. */
  static readonly onBrand: Resource = $r('app.color.on_brand');
  /** A tint of the accent: selected chips and rows, icon backgrounds. */
  static readonly brandSoft: Resource = $r('app.color.brand_soft');
  /** The page behind everything. */
  static readonly background: Resource = $r('sys.color.background_secondary');
  /** Cards, list rows, dialogs: one step above the page. */
  static readonly surface: Resource = $r('sys.color.comp_background_list_card');
  /** Input fields and neutral chips. */
  static readonly field: Resource = $r('sys.color.comp_background_tertiary');
  static readonly textPrimary: Resource = $r('sys.color.font_primary');
  static readonly textSecondary: Resource = $r('sys.color.font_secondary');
  static readonly textTertiary: Resource = $r('sys.color.font_tertiary');
  static readonly icon: Resource = $r('sys.color.icon_primary');
  static readonly iconSecondary: Resource = $r('sys.color.icon_secondary');
  static readonly divider: Resource = $r('sys.color.comp_divider');
  /** Destructive actions and error text. */
  static readonly danger: Resource = $r('sys.color.warning');
  static readonly onDanger: Resource = $r('sys.color.font_on_primary');
  /** Behind a dialog. */
  static readonly scrim: Resource = $r('sys.color.mask_fourth');
}

/** Spacing in vp: paddings, margins, gaps. */
export class Space {
  static readonly xs: number = 4;
  static readonly s: number = 8;
  static readonly m: number = 12;
  static readonly l: number = 16;
  static readonly xl: number = 24;
  static readonly xxl: number = 32;
}

/** Corner radii in vp. */
export class Radius {
  static readonly s: number = 8;
  static readonly m: number = 12;
  static readonly l: number = 16;
  static readonly pill: number = 24;
}

/** Font sizes (system type scale): .fontSize(Type.body). */
export class Type {
  /** A screen's one big number or headline. */
  static readonly display: Resource = $r('sys.float.Title_L');
  /** App bar titles. */
  static readonly title: Resource = $r('sys.float.Title_M');
  /** Section and dialog titles, a row's main text. */
  static readonly subtitle: Resource = $r('sys.float.Subtitle_M');
  /** Running text, buttons, inputs. */
  static readonly body: Resource = $r('sys.float.Body_L');
  /** Secondary lines under a title. */
  static readonly secondary: Resource = $r('sys.float.Body_M');
  /** Labels, captions, section headers. */
  static readonly caption: Resource = $r('sys.float.Body_S');
}

/** Sizes in vp that keep controls tappable and rows even. */
export class Size {
  /** The smallest tap target. */
  static readonly tap: number = 40;
  static readonly button: number = 48;
  static readonly row: number = 56;
  static readonly appBar: number = 56;
  static readonly icon: number = 24;
  /** A switch at the platform's size; a taller one is drawn as a ring. */
  static readonly switchWidth: number = 36;
  static readonly switchHeight: number = 20;
}
