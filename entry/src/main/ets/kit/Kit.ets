/** A setting that is on or off: label, optional explanation, a switch. `eid` is the switch. */
@ComponentV2
export struct ToggleRow {
  @Param title: ResourceStr = '';
  @Param subtitle: ResourceStr = '';
  @Param isOn: boolean = false;
  @Param eid: string = '';
  @Event onChange: (isOn: boolean) => void = (isOn: boolean) => {
  };

  build() {
    Row({ space: Space.m }) {
      Column({ space: Space.xs }) {
        Text(this.title)
          .fontSize(Type.body)
          .fontColor(AppColors.textPrimary)
        if (this.subtitle !== '') {
          Text(this.subtitle)
            .fontSize(Type.secondary)
            .fontColor(AppColors.textSecondary)
        }
      }
      .alignItems(HorizontalAlign.Start)
      .layoutWeight(1)

      Toggle({ type: ToggleType.Switch, isOn: this.isOn })
        .id(this.eid)
        .size({ width: Size.switchWidth, height: Size.switchHeight })
        .selectedColor(AppColors.brand)
        .responseRegion({ x: -Space.s, y: -Space.m, width: Size.switchWidth + 2 * Space.s, height: Size.switchHeight + 2 * Space.m })
        .onChange((isOn: boolean) => {
          if (isOn !== this.isOn) {
            this.onChange(isOn);
          }
        })
    }
    .width('100%')
    .constraintSize({ minHeight: Size.row })
    .padding({ left: Space.l, right: Space.l, top: Space.s, bottom: Space.s })
    .onClick(() => {
      this.onChange(!this.isOn);
    })
  }
}

