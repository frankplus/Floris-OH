/**
 * An icon-only action (app bar actions, row actions): a system symbol in a 40 vp tap target.
 * `label` is what a screen reader says; always give it.
 *   IconButton({ symbol: $r('sys.symbol.gearshape'), label: $r('app.string.<label>'), eid: 'open_settings', onTap: () => { ... } })
 * A menu from it (an overflow menu) opens from onTap, with a @Local menuShown: boolean of the page:
 *   IconButton({ ..., onTap: () => { this.menuShown = true; } })
 *     .bindMenu(this.menuShown, this.menu, { onDisappear: () => { this.menuShown = false; } })
 * A bare .bindMenu(this.menu) on it never opens: the tap goes to the button inside.
 */
@ComponentV2
export struct IconButton {
  @Param @Require symbol: Resource;
  @Param label: ResourceStr = '';
  @Param eid: string = '';
  @Param tint: ResourceColor = AppColors.icon;
  @Event onTap: () => void = () => {
  };

  build() {
    Button({ type: ButtonType.Circle }) {
      SymbolGlyph(this.symbol)
        .fontSize(Size.icon)
        .fontColor([this.tint])
    }
    .id(this.eid)
    .width(Size.tap)
    .height(Size.tap)
    .backgroundColor(Color.Transparent)
    .accessibilityText(this.label as string)
    .onClick(() => {
      this.onTap();
    })
  }
}

/**
