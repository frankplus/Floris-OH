  @Param eid: string = '';
  @Event onTap: () => void = () => {
  };

  build() {
    Row({ space: Space.m }) {
      Column({ space: Space.xs }) {
        Text(this.title)
          .fontSize(Type.body)
          .fontColor(AppColors.textPrimary)
          .maxLines(2)
          .textOverflow({ overflow: TextOverflow.Ellipsis })
        if (this.subtitle !== '') {
          Text(this.subtitle)
            .fontSize(Type.secondary)
            .fontColor(AppColors.textSecondary)
            .maxLines(2)
            .textOverflow({ overflow: TextOverflow.Ellipsis })
        }
      }
      .alignItems(HorizontalAlign.Start)
      .layoutWeight(1)

