// Generated by the app factory: the component kit. Compose screens from these parts and the tokens in
// ../theme/Theme; write your own component (in your components/ folder, with the same tokens) only when
// none of these fits. Every part takes `eid`: the element id the spec names for it (the walker's selectors).
// Texts are ResourceStr: pass $r('app.string.<name>') for anything the user reads, a string for data.
import { AppColors, Radius, Size, Space, Type } from '../theme/Theme';

@Builder
function nothing() {
}

/**
 * The bar at the top of every screen: back (not on the home screen), the title, up to three actions.
 *   AppBar({ title: $r('app.string.<title>'), onBack: () => { this.pathStack.pop(); } })
 *   AppBar({ title: $r('app.string.<title>'), showBack: false, actions: () => { this.barActions(); } })
 * where barActions is a @Builder of the page holding IconButton(...)s.
 */
@ComponentV2
export struct AppBar {
  @Param title: ResourceStr = '';
  @Param showBack: boolean = true;
  /** Id of the back button. */
  @Param backId: string = 'nav_back';
  /** Id of the title text. */
  @Param titleId: string = '';
  @Event onBack: () => void = () => {
  };
  @BuilderParam actions: () => void = nothing;

  build() {
    Row({ space: Space.xs }) {
      if (this.showBack) {
        IconButton({ symbol: $r('sys.symbol.arrow_left'), label: $r('app.string.kit_back'), eid: this.backId, onTap: () => { this.onBack(); } })
      }
      Text(this.title)
        .id(this.titleId)
        .fontSize(Type.title)
        .fontWeight(FontWeight.Bold)
        .fontColor(AppColors.textPrimary)
        .maxLines(1)
        .textOverflow({ overflow: TextOverflow.Ellipsis })
        .layoutWeight(1)
        .margin({ left: this.showBack ? Space.xs : Space.s })
      this.actions()
    }
    .width('100%')
    .height(Size.appBar)
    .padding({ left: Space.s, right: Space.s })
  }
}

/** The screen's one primary action: filled with the accent. `destructive` fills it with the danger colour (confirm a delete). */
@ComponentV2
export struct PrimaryButton {
  @Param label: ResourceStr = '';
  @Param eid: string = '';
  @Param isEnabled: boolean = true;
  @Param destructive: boolean = false;
  /** false: as wide as its label. In a row of buttons keep it true and give each .layoutWeight(1): each fills its share. */
  @Param fill: boolean = true;
  /** true while the action it started runs (a save awaiting storage): it keeps its colours, dims and takes no second tap. */
  @Param busy: boolean = false;
  @Event onTap: () => void = () => {
  };

  build() {
    Button(this.label, { type: ButtonType.Capsule })
      .id(this.eid)
      .width(this.fill ? '100%' : undefined)
      .height(Size.button)
      .padding({ left: Space.xl, right: Space.xl })
      .fontSize(Type.body)
      .fontWeight(FontWeight.Medium)
      .fontColor(this.isEnabled ? (this.destructive ? AppColors.onDanger : AppColors.onBrand) : AppColors.textPrimary)
      .backgroundColor(this.isEnabled ? (this.destructive ? AppColors.danger : AppColors.brand) : AppColors.field)
      .opacity(this.busy ? 0.6 : 1)
      .enabled(this.isEnabled && !this.busy)
      .onClick(() => {
        this.onTap();
      })
  }
}

/** Any other action next to or below the primary one: a tinted button. `destructive` gives it the danger colour on a neutral fill (Delete beside Edit). */
@ComponentV2
export struct SecondaryButton {
  @Param label: ResourceStr = '';
  @Param eid: string = '';
  @Param isEnabled: boolean = true;
  @Param destructive: boolean = false;
  @Param fill: boolean = true;
  @Event onTap: () => void = () => {
  };

  build() {
    Button(this.label, { type: ButtonType.Capsule })
      .id(this.eid)
      .width(this.fill ? '100%' : undefined)
      .height(Size.button)
      .padding({ left: Space.xl, right: Space.xl })
      .fontSize(Type.body)
      .fontWeight(FontWeight.Medium)
      .fontColor(this.isEnabled ? (this.destructive ? AppColors.danger : AppColors.brand) : AppColors.textPrimary)
      .backgroundColor(this.isEnabled && !this.destructive ? AppColors.brandSoft : AppColors.field)
      .enabled(this.isEnabled)
      .onClick(() => {
        this.onTap();
      })
  }
}

/** A low-emphasis action in running content (Cancel, Undo, Clear filters): text in the accent, no fill. `destructive` colours it as danger. */
@ComponentV2
export struct TextButton {
  @Param label: ResourceStr = '';
