/**
 * A labelled text input with an optional line under it: `hint` (secondary text: what the field needs, shown from
 * the start) or `error` (danger colour: what is wrong with what the user entered; it replaces the hint). `eid` is the input.
 * onChange runs for what the user types only, not when the screen sets `text` (loading a record), so a field touched
 * in onChange is one the user has changed; keep `text` set to what onChange gives you.
 *   TextField({ label: $r('app.string.<label>'), text: this.title, eid: 'title_input', hint: $r('app.string.<rule>'), hintId: 'title_hint', onChange: (v: string) => { this.title = v; } })
 */
@ComponentV2
export struct TextField {
  @Param label: ResourceStr = '';
  @Param text: string = '';
  @Param placeholder: ResourceStr = '';
  @Param error: ResourceStr = '';
  @Param errorId: string = '';
  @Param hint: ResourceStr = '';
  @Param hintId: string = '';
  @Param inputType: InputType = InputType.Normal;
  @Param eid: string = '';
  @Event onChange: (value: string) => void = (value: string) => {
  };

  build() {
    Column({ space: Space.xs }) {
      if (this.label !== '') {
        Text(this.label)
          .fontSize(Type.caption)
          .fontWeight(FontWeight.Medium)
          .fontColor(AppColors.textSecondary)
      }
      TextInput({ text: this.text, placeholder: this.placeholder })
        .id(this.eid)
        .type(this.inputType)
        .height(Size.button)
        .fontSize(Type.body)
        .fontColor(AppColors.textPrimary)
        .placeholderColor(AppColors.textTertiary)
        .backgroundColor(AppColors.field)
        .borderRadius(Radius.m)
        .onChange((value: string) => {
          // A text the screen set (a record loaded into the form) comes back through the input's onChange
          // too; only what the user typed is passed on, so a screen that marks a field touched there keeps
          // its hint (expenses-g-4). The screen keeps text in step with what onChange gives it.
          if (value !== this.text) {
            this.onChange(value);
          }
        })
      if (this.error !== '') {
        Text(this.error)
          .id(this.errorId)
          .fontSize(Type.caption)
          .fontColor(AppColors.danger)
      } else if (this.hint !== '') {
        Text(this.hint)
          .id(this.hintId)
          .fontSize(Type.caption)
          .fontColor(AppColors.textSecondary)
      }
    }
    .alignItems(HorizontalAlign.Start)
    .width('100%')
  }
}

/**
 * A confirmation over the page: a title, an optional message, Cancel and the confirming action
 * (`destructive` for deletes). The page's root is a Stack; put this last in it, inside an if:
 *   if (this.confirmDelete) {
 *     ConfirmDialog({ title: $r('app.string.<question>'), confirmLabel: $r('app.string.<action>'), destructive: true,
 *       confirmId: 'confirm_delete', cancelId: 'cancel_delete',
 *       onConfirm: () => { ... this.confirmDelete = false; }, onCancel: () => { this.confirmDelete = false; } })
 *   }
 */
@ComponentV2
export struct ConfirmDialog {
  @Param title: ResourceStr = '';
  @Param message: ResourceStr = '';
  @Param confirmLabel: ResourceStr = $r('app.string.kit_ok');
  @Param cancelLabel: ResourceStr = $r('app.string.kit_cancel');
  @Param destructive: boolean = false;
  @Param eid: string = '';
  @Param confirmId: string = 'dialog_confirm';
  @Param cancelId: string = 'dialog_cancel';
  @Event onConfirm: () => void = () => {
  };
  @Event onCancel: () => void = () => {
  };

  build() {
    Column() {
      Column({ space: Space.m }) {
        Text(this.title)
          .fontSize(Type.subtitle)
          .fontWeight(FontWeight.Medium)
          .fontColor(AppColors.textPrimary)
          .width('100%')
        if (this.message !== '') {
          Text(this.message)
            .fontSize(Type.secondary)
            .fontColor(AppColors.textSecondary)
            .width('100%')
        }
        Row({ space: Space.m }) {
          SecondaryButton({ label: this.cancelLabel, eid: this.cancelId, onTap: () => { this.onCancel(); } })
            .layoutWeight(1)
          PrimaryButton({ label: this.confirmLabel, eid: this.confirmId, destructive: this.destructive, onTap: () => { this.onConfirm(); } })
            .layoutWeight(1)
        }
        .width('100%')
        .margin({ top: Space.s })
      }
      .id(this.eid)
      .width('100%')
      .padding(Space.xl)
      .backgroundColor(AppColors.surface)
      .borderRadius(Radius.pill)
      .onClick(() => {
        // Taps on the card do not reach the scrim.
      })
    }
    .width('100%')
    .height('100%')
    .padding(Space.xl)
    .justifyContent(FlexAlign.Center)
    .backgroundColor(AppColors.scrim)
    .onClick(() => {
      this.onCancel();
    })
  }
}
