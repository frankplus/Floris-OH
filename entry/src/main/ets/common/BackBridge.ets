// Generated by the app factory: the Back key on the home screen. The navigation host's
// onBackPress calls handle(); a screen that must consume Back (close a panel, dismiss a
// dialog, leave a mode) registers a handler and returns true from it when it did.
export type BackHandler = () => boolean;

export class BackBridge {
  private static handler: BackHandler | null = null;

  static set(handler: BackHandler | null): void {
    BackBridge.handler = handler;
  }

  static handle(): boolean {
    return BackBridge.handler ? BackBridge.handler() : false;
  }
}

// The home screen is in front again: at launch and each time a pushed screen is left (Back, or
// its bar's back button). The home screen is not a NavDestination, so it has no onShown, and a
// callback given to pushPathByName runs only when the other screen pops with a result. The home
// screen registers a listener here and reloads what other screens may have changed.
export type HomeShownListener = () => void;

export class HomeShown {
  private static listener: HomeShownListener | null = null;

  static set(listener: HomeShownListener | null): void {
    HomeShown.listener = listener;
  }

  static notify(): void {
    if (HomeShown.listener) {
      HomeShown.listener();
    }
  }
}
