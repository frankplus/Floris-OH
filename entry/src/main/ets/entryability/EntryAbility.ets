// Generated by the app factory: the entry ability. The app follows the system's light or dark mode.
// A launch may carry the want parameter 'factory_color_mode' (dark | light | auto) to switch it: the
// factory's walker uses it to photograph every page in both modes.
import { AbilityConstant, ConfigurationConstant, UIAbility, Want } from '@kit.AbilityKit';
import { hilog } from '@kit.PerformanceAnalysisKit';
import { BusinessError } from '@kit.BasicServicesKit';
import { KeyboardAvoidMode, window } from '@kit.ArkUI';
import { SettingsStore } from '../model/SettingsStore';

const DOMAIN = 0x0000;
const TAG = 'EntryAbility';

export default class EntryAbility extends UIAbility {
  private applyColorMode(want: Want): void {
    const asked = want.parameters?.['factory_color_mode'];
    let mode: ConfigurationConstant.ColorMode = ConfigurationConstant.ColorMode.COLOR_MODE_NOT_SET;
    if (asked === 'dark') {
      mode = ConfigurationConstant.ColorMode.COLOR_MODE_DARK;
    } else if (asked === 'light') {
      mode = ConfigurationConstant.ColorMode.COLOR_MODE_LIGHT;
    }
    try {
      this.context.getApplicationContext().setColorMode(mode);
    } catch (err) {
      hilog.error(DOMAIN, TAG, 'setColorMode failed: %{public}s', JSON.stringify(err));
    }
    if (asked === 'dark') {
      this.forced = 'dark';
    } else if (asked === 'light') {
      this.forced = 'light';
    } else if (this.forced !== '') {
      this.forced = 'auto';
    }
    this.applyBarColor();
  }

  // The system picks the status bar's text colour from its own mode; when the app's mode is forced, set it.
  private applyBarColor(): void {
    if (this.forced === '' || this.mainWindow === undefined) {
      return;
    }
    const dark = this.forced === 'dark' || (this.forced === 'auto' && this.systemDark);
    this.mainWindow.setWindowSystemBarProperties({ statusBarContentColor: dark ? '#FFFFFF' : '#000000' }).catch((err: BusinessError) => {
      hilog.error(DOMAIN, TAG, 'setWindowSystemBarProperties failed: %{public}s', JSON.stringify(err));
    });
  }

  private forced: string = '';
  private systemDark: boolean = false;
  private mainWindow: window.Window | undefined = undefined;

  // The data layer opens before the first page shows. A store that fails to open is logged; the pages still load.
  private async openStores(): Promise<void> {
    try {
      await SettingsStore.getInstance().init(this.context);
    } catch (err) {
      hilog.error(DOMAIN, TAG, 'SettingsStore.init failed: %{public}s', JSON.stringify(err));
    }
  }

  onCreate(want: Want, launchParam: AbilityConstant.LaunchParam): void {
    this.systemDark = this.context.config.colorMode === ConfigurationConstant.ColorMode.COLOR_MODE_DARK;
    this.applyColorMode(want);
  }

  onNewWant(want: Want, launchParam: AbilityConstant.LaunchParam): void {
    if (want.parameters?.['factory_color_mode'] !== undefined) {
      this.applyColorMode(want);
    }
  }

  onWindowStageCreate(windowStage: window.WindowStage): void {
    try {
      this.mainWindow = windowStage.getMainWindowSync();
      this.applyBarColor();
    } catch (err) {
      hilog.error(DOMAIN, TAG, 'getMainWindowSync failed: %{public}s', JSON.stringify(err));
    }
    this.openStores().then(() => {
      windowStage.loadContent('pages/Index', (err) => {
        if (err.code) {
          hilog.error(DOMAIN, TAG, 'loadContent failed: %{public}s', JSON.stringify(err));
          return;
        }
        // The window shrinks above the soft keyboard, so a form's content stays reachable in its Scroll.
        try {
          windowStage.getMainWindowSync().getUIContext().setKeyboardAvoidMode(KeyboardAvoidMode.RESIZE);
        } catch (e) {
          hilog.error(DOMAIN, TAG, 'setKeyboardAvoidMode failed: %{public}s', JSON.stringify(e));
        }
      });
    });
  }
}
