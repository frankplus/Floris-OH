import { BackBridge, HomeShown } from '../common/BackBridge';
import { HomePage } from '../screens/HomePage';
import { KeyboardPage } from '../screens/KeyboardPage';
import { InputFeedbackPage } from '../screens/InputFeedbackPage';
import { TypingPage } from '../screens/TypingPage';
import { ThemePage } from '../screens/ThemePage';
import { LocalizationPage } from '../screens/LocalizationPage';
import { AboutPage } from '../screens/AboutPage';

// Generated by the app factory from the AppSpec: the navigation host. Every screen except
// the home screen is a NavDestination pushed by name; the stack is shared with all screens
// through @Provider('pathStack') / @Consumer('pathStack').
@Entry
@ComponentV2
struct Index {
  @Provider('pathStack') pathStack: NavPathStack = new NavPathStack();

  @Builder
  routes(name: string) {
    if (name === 'Keyboard') {
      KeyboardPage()
    } else if (name === 'InputFeedback') {
      InputFeedbackPage()
    } else if (name === 'Typing') {
      TypingPage()
    } else if (name === 'Theme') {
      ThemePage()
    } else if (name === 'Localization') {
      LocalizationPage()
    } else if (name === 'About') {
      AboutPage()
    }
  }

  // Back on the home screen: a screen that registered a handler with BackBridge (an open panel,
  // a dialog, a mode) gets to consume it; otherwise the system leaves the app.
  onBackPress(): boolean {
    return BackBridge.handle();
  }

  build() {
    Navigation(this.pathStack) {
      HomePage()
    }
    .navDestination(this.routes)
    .hideTitleBar(true)
    .mode(NavigationMode.Stack)
    // The home screen is not a NavDestination and gets no onShown: tell it when it is in front again.
    .onNavBarStateChange((visible: boolean) => {
      if (visible) {
        HomeShown.notify();
      }
    })
    .id('nav_root')
  }
}
