import { abilityDelegatorRegistry, Driver, ON } from '@kit.TestKit';
import { describe, expect, it } from '@ohos/hypium';
import { Want } from '@kit.AbilityKit';

const delegator: abilityDelegatorRegistry.AbilityDelegator = abilityDelegatorRegistry.getAbilityDelegator();
const bundleName: string = abilityDelegatorRegistry.getArguments().bundleName;

// Generated by the app factory: the app starts on its home screen.
export default function shellTest() {
  describe('ShellTest', () => {
    it('startsOnHome', 0, async () => {
      const want: Want = { bundleName: bundleName, abilityName: 'EntryAbility' };
      await delegator.startAbility(want);
      const driver: Driver = Driver.create();
      await driver.waitForComponent(ON.id('page_Home'), 8000);
      expect(await driver.findComponent(ON.id('page_Home')) !== null).assertTrue();
    })
  })
}
